{
  "name": "haste-lifeos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev:today": "vite --config vite.today.config.mjs",
    "build:today": "vite build --config vite.today.config.mjs",
    "test": "node test/smoke.js && node test/worker-smoke.js && node test/verify-script-smoke.js && node test/ui-smoke.js",
    "deploy": "npm run build:today && wrangler deploy",
    "preview": "npm run build:today && wrangler dev"
  },
  "description": "Personal life dashboard MVP",
  "dependencies": {
    "lucide-react": "^1.47.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260908.1": true
  }
}
