{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdmaz",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdmaz-db",
      "database_id": "6f725d4a-9d22-43f4-a58f-297c8d2ece34"
    }
  ],
  // Workers AI: on-device translation (m2m100) when the external AI keys are refused
  "ai": { "binding": "AI" },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
