# Never commit or send the real values in chat.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local development example: http://localhost:3000/api/auth/google/callback
# Production example: https://app.your-domain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Google Calendar - reuses the Google OAuth client above. Enable Google
# Calendar API, add this exact URI to "Authorized redirect URIs", then connect
# from Settings. LifeOS requests read-only access to visible calendars and
# write access only to the secondary calendar it creates itself.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# API-Football / API-Sports - keeps fixture, result and 1xBet odds data server-side
API_FOOTBALL_KEY=your-api-football-key

# RapidAPI - a single key that powers three optional football data sources:
#  1) API-FOOTBALL via RapidAPI, used automatically as a fallback for
#     /api/football/remote/fixtures and /odds when API_FOOTBALL_KEY above
#     is not set (subscribe to "API-FOOTBALL" on rapidapi.com)
#  2) Direct 1xBet odds/markets (subscribe to "1xBet API" on rapidapi.com)
#  3) SofaScore-style detailed match stats (subscribe to "SportAPI"/sportapi7
#     on rapidapi.com)
RAPIDAPI_KEY=your-rapidapi-key

# TMDB - movie/series search, posters, ratings
TMDB_API_KEY=your-tmdb-api-key

# Telegram bot - get a token from @BotFather. The bot runs via long-polling
# (no public URL needed), so this is the only Telegram variable required.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Spotify - from developer.spotify.com; add SPOTIFY_REDIRECT_URI as an
# allowed redirect URI in the Spotify app dashboard.
# Local development example: http://localhost:3000/api/integrations/spotify/callback
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/integrations/spotify/callback

# YouTube - reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above with an
# expanded scope; add this as a second allowed redirect URI on the same
# Google Cloud OAuth client used for Google login.
# Local development example: http://localhost:3000/api/integrations/youtube/callback
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/callback

# AI assistant (chat with your data, smart reports, free-text understanding).
# Get a key from console.anthropic.com. Correlation analysis and the
# deadline/habit part of tomorrow's-priorities work without this key;
# chat, reports, AI category guesses, and AI-assisted free-text parsing
# need it.
AI_PROVIDER_API_KEY=your-anthropic-api-key
# Optional: override the model (defaults to claude-sonnet-5)
AI_MODEL=claude-sonnet-5
# Optional: point at an OpenAI-compatible provider instead of Anthropic
# (leave both unset to keep using Anthropic's native API above). Examples:
#   Groq:       AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
#               AI_MODEL=openai/gpt-oss-120b   (llama-3.3-70b-versatile was retired by Groq)
#   Gemini:     AI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#               AI_MODEL=gemini-2.0-flash
#   OpenRouter: AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
#               AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
AI_PROVIDER_BASE_URL=

# Twelve Data - live US stock prices for the portfolio (twelvedata.com,
# free tier). Not needed for crypto prices, which use CoinGecko's free
# public API with no key at all.
STOCK_API_KEY=your-twelvedata-api-key
