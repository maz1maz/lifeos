# Never commit or send the real values in chat.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local development example: http://localhost:3000/api/auth/google/callback
# Production example: https://app.your-domain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# API-Football / API-Sports - keeps fixture, result and 1xBet odds data server-side
API_FOOTBALL_KEY=your-api-football-key

# TMDB - movie/series search, posters, ratings
TMDB_API_KEY=your-tmdb-api-key

# Telegram bot - get a token from @BotFather. The bot runs via long-polling
# (no public URL needed), so this is the only Telegram variable required.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Spotify - from developer.spotify.com; add SPOTIFY_REDIRECT_URI as an
# allowed redirect URI in the Spotify app dashboard.
# Local development example: http://localhost:3000/api/integrations/spotify/callback
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/integrations/spotify/callback

# YouTube - reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above with an
# expanded scope; add this as a second allowed redirect URI on the same
# Google Cloud OAuth client used for Google login.
# Local development example: http://localhost:3000/api/integrations/youtube/callback
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/callback
