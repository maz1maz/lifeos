# Never commit or send the real values in chat.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local development example: http://localhost:3000/api/auth/google/callback
# Production example: https://app.your-domain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# API-Football / API-Sports - keeps fixture, result and 1xBet odds data server-side
API_FOOTBALL_KEY=your-api-football-key
